# Copy to .env or export these in the shell. Do not commit real values.

# Listener
KEZIAH_MODE=hybrid
KEZIAH_DB=~/.keziah/keziah.db
KEZIAH_HOST=127.0.0.1
KEZIAH_PORT=8766
KEZIAH_CONFIG=./keziah.yaml
KEZIAH_LOG_LEVEL=info
KEZIAH_API_KEY=

# Jev. Either name is accepted. Never log the value.
TYPESAFE_API_KEY=
JEV_API_KEY=

# Optional Laya runtime hints. Used by the Laya adapter when set in config,
# and by a standalone `laya-serve` process if you run one beside Keziah.
# LAYA_DEVICE=cpu
# LAYA_THREADS=4
